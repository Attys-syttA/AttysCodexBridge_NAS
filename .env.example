TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELECODEX_HOST_LABEL=worker-host
CODEX_API_KEY=
CODEX_MODEL=
# Keep these relative so the same checkout works under any <CODEX_WORKS> parent folder.
TELECODEX_WORKSPACE_ROOT=..
TELECODEX_DEFAULT_WORKSPACE=..\email-header-analyzer
TELECODEX_STATE_DIR=.telecodex
TELECODEX_RUNTIME_MODE=local
TELECODEX_WORKERS_JSON=
TELECODEX_DEFAULT_WORKER_ID=
TELECODEX_WORKER_BASE_URL=
TELECODEX_WORKER_SHARED_SECRET=
TELECODEX_WORKER_TIMEOUT_MS=120000
MAX_FILE_SIZE=20971520
TELECODEX_VSC_HANDOFF_DIRECT_RESUME_MAX_SESSION_BYTES=20971520
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never
# Optional extra profiles for /launch_profiles, e.g. [{"id":"review","label":"Review","sandboxMode":"workspace-write","approvalPolicy":"on-request","capabilityMode":"safe"},{"id":"github-write","label":"GitHub Write","sandboxMode":"workspace-write","approvalPolicy":"on-request","capabilityMode":"github-write"}]
CODEX_LAUNCH_PROFILES_JSON=
CODEX_DEFAULT_LAUNCH_PROFILE=default
# Set to true to expose the built-in Full Access profile and allow extra danger-full-access profiles.
ENABLE_UNSAFE_LAUNCH_PROFILES=false
TOOL_VERBOSITY=summary
SHOW_TURN_TOKEN_USAGE=false
ENABLE_TELEGRAM_LOGIN=true
ENABLE_TELEGRAM_REACTIONS=false
OPENAI_API_KEY=
