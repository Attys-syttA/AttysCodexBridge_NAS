{
  "name": "attys-codex-bridge",
  "version": "0.1.0",
  "description": "AttysCodexBridge - Telegram bridge for the OpenAI Codex CLI SDK",
  "license": "MIT",
  "author": "Attys-syttA",
  "repository": {
    "type": "git",
    "url": "https://github.com/Attys-syttA/AttysCodexBridge"
  },
  "keywords": [
    "telegram-bot",
    "codex",
    "openai",
    "openai-codex",
    "chatops",
    "developer-tools",
    "typescript",
    "bridge"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:bridge": "tsx watch src/index.ts",
    "dev:worker": "tsx src/index.ts",
    "build": "tsc",
    "nas:inventory:check": "node scripts/nas-runtime-inventory-check.mjs",
    "nas:inventory:write": "node scripts/nas-runtime-inventory-check.mjs --write",
    "nas:bundle:check": "node scripts/build-nas-bundle.mjs",
    "build:nas-bundle": "node scripts/build-nas-bundle.mjs --write --clean",
    "start": "node dist/index.js",
    "start:bridge": "node dist/index.js",
    "start:worker": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@openai/codex-sdk": "^0.137.0",
    "grammy": "^1.41.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^25.5.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0",
    "parakeet-coreml": "^2.2.0"
  }
}
