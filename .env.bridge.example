TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELECODEX_HOST_LABEL=nas-bridge

TELECODEX_RUNTIME_MODE=remote-bridge
TELECODEX_WORKERS_JSON=[{"id":"munkahely","label":"Munkahely","baseUrl":"http://192.168.1.50:8787","sharedSecret":"IRJ_IDE_EGY_HOSSZU_TITKOT"},{"id":"otthon","label":"Otthon","baseUrl":"http://192.168.1.60:8787","sharedSecret":"IRJ_IDE_EGY_HOSSZU_TITKOT"}]
TELECODEX_DEFAULT_WORKER_ID=munkahely
TELECODEX_WORKER_TIMEOUT_MS=120000

TELECODEX_STATE_DIR=/data/bridge-state
TELECODEX_WORKSPACE_ROOT=/workspace
TELECODEX_DEFAULT_WORKSPACE=/workspace

CODEX_MODEL=gpt-5.4
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never
CODEX_DEFAULT_LAUNCH_PROFILE=default
ENABLE_UNSAFE_LAUNCH_PROFILES=false

MAX_FILE_SIZE=20971520
TELECODEX_VSC_HANDOFF_DIRECT_RESUME_MAX_SESSION_BYTES=20971520
TOOL_VERBOSITY=summary
SHOW_TURN_TOKEN_USAGE=false
ENABLE_TELEGRAM_LOGIN=true
ENABLE_TELEGRAM_REACTIONS=false
TELEGRAM_API_TIMEOUT_MS=20000
TELEGRAM_EDIT_DEBOUNCE_MS=5000
TELEGRAM_TYPING_INTERVAL_MS=30000
CODEX_NO_OUTPUT_STATUS_MS=300000
CODEX_TURN_HARD_TIMEOUT_MS=3600000

NODE_OPTIONS=--max-old-space-size=384
