{
  "schemaVersion": 1,
  "packageName": "telegram-codex-bot-bridge",
  "include": [
    ".dockerignore",
    ".env.bridge.example",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "Dockerfile.bridge",
    "Dockerfile.bridge.dev",
    "docker-compose.bridge.yml",
    "docker-compose.bridge.dev.yml",
    "dist/**",
